{
    "name": "deckfaqs",
    "version": "2.2.2",
    "description": "GameFAQs browser for the Steam Deck",
    "type": "module",
    "scripts": {
        "build": "rollup -c",
        "watch": "rollup -c -w",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:smoke": "vitest run --config vitest.smoke.config.ts",
        "lint:py": "uv run --frozen ruff check . && uv run --frozen ruff format --check .",
        "format:py": "uv run --frozen ruff check --fix . && uv run --frozen ruff format .",
        "typecheck:py": "uv run --frozen ty check",
        "test:py": "uv run --frozen pytest",
        "knip": "knip",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "package": "./scripts/package.sh",
        "release": "semantic-release",
        "prepare": "husky"
    },
    "author": "hulkrelax",
    "license": "MIT",
    "private": true,
    "devDependencies": {
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@decky/rollup": "^1.0.2",
        "@decky/ui": "^4.12.0",
        "@eslint/js": "^10.0.1",
        "@semantic-release/changelog": "^7.0.0",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^11.0.1",
        "@semantic-release/npm": "^13.1.5",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.2.0",
        "@types/react": "19.2.18",
        "@types/react-dom": "~19.2.4",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7",
        "globals": "^17.11.0",
        "husky": "^9",
        "jsdom": "^30.0.1",
        "knip": "^6.32.2",
        "lint-staged": "^17.3.0",
        "prettier": "3.9.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "rollup": "^4.53.3",
        "semantic-release": "^25.0.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "@decky/api": "^1.1.3",
        "dompurify": "^3.2.6",
        "react-icons": "^5.7.0"
    },
    "pnpm": {
        "peerDependencyRules": {
            "ignoreMissing": [
                "react",
                "react-dom"
            ]
        },
        "minimumReleaseAge": 4320
    },
    "packageManager": "pnpm@10.34.5",
    "lint-staged": {
        "*.{ts,tsx,js,mjs,cjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.py": [
            "uv run --frozen ruff check --fix",
            "uv run --frozen ruff format"
        ],
        "!(*.{ts,tsx,js,mjs,cjs,py})": "prettier --write --ignore-unknown"
    },
    "engines": {
        "node": ">=22.13"
    }
}
